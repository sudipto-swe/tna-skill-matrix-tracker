# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (sandbox default). For PostgreSQL, use e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/tna_skill_matrix
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Auth ─────────────────────────────────────────────────────────────────────
# Session signing secret. REQUIRED in production (>= 16 chars).
# Generate: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# ── Optional: email notifications ────────────────────────────────────────────
# While these are unset, the app honestly reports "email not configured"
# and keeps notifications in-app only (no fake sends).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=change-me
# SMTP_FROM="TNA Tracker <notifications@example.com>"
